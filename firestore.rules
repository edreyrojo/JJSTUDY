rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- FUNCIONES MEJORADAS Y BLINDADAS ---

    function isAuthenticated() {
      return request.auth != null;
    }

    // Devuelve null si el documento todavía no existe (usuario nuevo).
    function getUserData() {
      let userDoc = get(/databases/$(database)/documents/usuarios/$(request.auth.uid));
      return userDoc != null ? userDoc.data : null;
    }

    function getRol() {
      let userData = getUserData();
      return userData != null ? userData.get('rol', 'sin_rol') : 'sin_rol';
    }

    // Admin por UID histórico O por correo.
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.uid == "V3vfEnmtSzRNljxJVG8Za4gOb9W2" ||
        request.auth.token.email == "zamna.ed@gmail.com"
      );
    }

    function esAdminTotal() {
      return isAdmin() || (isAuthenticated() && getRol() == 'admin');
    }

    function esValidado() {
      return isAuthenticated() && (
        esAdminTotal() ||
        (getUserData() != null && getUserData().get('validado', false) == true)
      );
    }

    function getMiAcademia() {
      let data = getUserData();
      return data != null ? data.get('academiaId', data.get('teamId', request.auth.uid)) : request.auth.uid;
    }

    function getMiTeam() {
      let data = getUserData();
      return data != null ? data.get('teamId', data.get('academiaId', request.auth.uid)) : request.auth.uid;
    }

    function getMiSede() {
      let data = getUserData();
      return data != null ? data.get('sedeId', '') : '';
    }

    function esDeMiEquipo() {
      return resource.data.get('teamId', '') == getMiTeam() ||
             resource.data.get('academiaId', '') == getMiAcademia();
    }

    function esDuenoDelPerfil(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Comprueba que un código de sede existe y apunta a la sede indicada.
    function codigoValido(codigo, sedeId) {
      return codigo is string && codigo != '' && sedeId is string && sedeId != '' &&
        exists(/databases/$(database)/documents/codigosAcceso/$(codigo)) &&
        get(/databases/$(database)/documents/codigosAcceso/$(codigo)).data.get('sedeId', '') == sedeId;
    }

    // --- REGLAS DE COLECCIONES ---

    // 1. USUARIOS
    // Regla clave: un usuario NUNCA puede cambiarse a sí mismo el rol,
    // la validación, los cursos liberados ni el equipo/sede. Eso solo lo
    // hace el administrador. El único cambio de rol permitido es el
    // onboarding inicial (una sola vez) verificado por código o por team propio.
    match /usuarios/{userId} {

      allow get: if isAuthenticated() && (
        request.auth.uid == userId ||
        esAdminTotal() ||
        (getRol() in ['profesor', 'instructor'] && esDeMiEquipo())
      );

      allow list: if isAuthenticated() && (
        esAdminTotal() ||
        (getRol() in ['profesor', 'instructor'] && esDeMiEquipo()) ||
        resource.data.get('email', '') == request.auth.token.email
      );

      // Crear el propio perfil: SIEMPRE nace pendiente, sin cursos liberados
      // y sin equipo/sede asignados por el propio usuario.
      allow create: if isAuthenticated() && request.auth.uid == userId && (
        (
          request.resource.data.get('email', '') == request.auth.token.email &&
          request.resource.data.get('validado', false) == false &&
          request.resource.data.get('rol', 'alumno') in ['alumno', 'instructor', 'profesor'] &&
          request.resource.data.get('cursos_liberados', []).size() == 0 &&
          request.resource.data.get('teamId', null) == null &&
          request.resource.data.get('sedeId', null) == null
        ) ||
        (
          // Excepción: el maestro creando su propio perfil de admin.
          isAdmin() &&
          request.resource.data.get('rol', '') == 'admin' &&
          request.resource.data.get('validado', false) == true
        )
      );

      allow update: if isAuthenticated() && (
        // El administrador puede editar todo.
        esAdminTotal() ||
        (
          // Perfil: solo campos personales. Rol, validación, cursos,
          // email, equipo y sede quedan congelados.
          esDuenoDelPerfil(userId) &&
          request.resource.data.get('email', '') == resource.data.get('email', '') &&
          request.resource.data.get('rol', 'alumno') == resource.data.get('rol', 'alumno') &&
          request.resource.data.get('validado', false) == resource.data.get('validado', false) &&
          request.resource.data.get('cursos_liberados', []) == resource.data.get('cursos_liberados', []) &&
          request.resource.data.get('teamId', null) == resource.data.get('teamId', null) &&
          request.resource.data.get('sedeId', null) == resource.data.get('sedeId', null) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'nombre', 'fotoBase64', 'bio', 'cinturon', 'grados', 'edad', 'ciudad',
            'pesoCategoria', 'especialidad', 'tiempoEntrenando', 'genero',
            'telefono', 'emergencia', 'tipoSangre', 'instagram', 'tallaGi',
            'notas', 'vistos', 'ultimoAnuncioVisto',
            'necesitaOnboarding', 'fechaActualizacion', 'fechaUltimoAcceso'
          ])
        ) ||
        (
          // Desvincularse de una academia: solo se permite dejar los campos
          // en null. Unirse a otra academia pasa por el staff/onboarding.
          esDuenoDelPerfil(userId) &&
          request.resource.data.get('academiaId', null) == null &&
          request.resource.data.get('academiaNombre', null) == null &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['academiaId', 'academiaNombre'])
        ) ||
        (
          // Onboarding inicial (una sola vez): el usuario ya es staff y aún no
          // tiene equipo. Un alumno normal NO puede auto-promoverse.
          esDuenoDelPerfil(userId) &&
          resource.data.get('rol', 'alumno') in ['profesor', 'instructor'] &&
          resource.data.get('necesitaOnboarding', false) == true &&
          request.resource.data.get('necesitaOnboarding', false) == false &&
          request.resource.data.get('validado', false) == resource.data.get('validado', false) &&
          request.resource.data.get('cursos_liberados', []).size() == 0 &&
          (
            // Fundador: crea su propio team (teamId = su uid).
            (
              request.resource.data.get('rol', '') == 'profesor' &&
              request.resource.data.get('teamId', '') == request.auth.uid &&
              request.resource.data.get('academiaId', '') == request.auth.uid
            ) ||
            // Instructor o profesor que se une con un código de sede válido.
            (
              request.resource.data.get('rol', '') in ['profesor', 'instructor'] &&
              request.resource.data.get('teamId', '') == request.resource.data.get('academiaId', '') &&
              codigoValido(
                request.resource.data.get('codigoVerificado', ''),
                request.resource.data.get('sedeId', '')
              )
            )
          ) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'rol', 'teamId', 'sedeId', 'academiaId', 'academiaNombre',
            'necesitaOnboarding', 'fechaVinculacion', 'fechaActualizacion',
            'codigoVerificado'
          ])
        ) ||
        (
          // Re-vincularse a otra sede usando el código de esa sede.
          // El rol no puede cambiar y los cursos liberados se conservan.
          esDuenoDelPerfil(userId) &&
          resource.data.get('necesitaOnboarding', false) == false &&
          getRol() in ['profesor', 'instructor'] &&
          request.resource.data.get('validado', false) == resource.data.get('validado', false) &&
          request.resource.data.get('cursos_liberados', []) == resource.data.get('cursos_liberados', []) &&
          request.resource.data.get('rol', '') == resource.data.get('rol', '') &&
          request.resource.data.get('teamId', '') == request.resource.data.get('academiaId', '') &&
          codigoValido(
            request.resource.data.get('codigoVerificado', ''),
            request.resource.data.get('sedeId', '')
          ) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'teamId', 'sedeId', 'academiaId', 'academiaNombre',
            'necesitaOnboarding', 'fechaVinculacion', 'fechaActualizacion',
            'codigoVerificado'
          ])
        )
      );

      allow delete: if esAdminTotal();
    }

    // 2. TEAMS
    match /teams/{teamId} {
      allow read: if isAuthenticated() && (
        esAdminTotal() || request.auth.uid == teamId || getMiTeam() == teamId
      );
      allow create: if isAuthenticated() && (
        request.auth.uid == teamId ||
        esAdminTotal() ||
        (esValidado() && getRol() in ['profesor', 'instructor'] &&
          request.resource.data.get('propietarioUid', '') == request.auth.uid)
      );
      allow update, delete: if isAuthenticated() && (request.auth.uid == teamId || esAdminTotal());
    }

    // 3. SEDES
    // Solo se leen las sedes del propio equipo (o todas si eres admin).
    // El código de acceso se valida contra el mapeo privado `codigosAcceso`.
    match /sedes/{sedeId} {
      allow read: if isAuthenticated() && (
        esAdminTotal() ||
        getMiSede() == sedeId ||
        (getUserData() != null && resource.data.get('teamId', '') == getMiTeam())
      );

      // Permite crear la sede del propio team (onboarding del fundador) o
      // una sede afiliada por parte del staff ya validado.
      allow create: if esValidado() && (
        esAdminTotal() ||
        request.auth.uid == request.resource.data.get('teamId', '') ||
        (getRol() in ['profesor', 'instructor'] && (
          request.resource.data.get('teamId', '') == getMiTeam() ||
          request.resource.data.get('teamId', '') == request.auth.uid
        ))
      );

      // El staff puede editar su sede, pero NO cambiar el team ni el código
      // de acceso (eso solo lo hace el administrador). Tampoco puede borrarla.
      allow update: if isAuthenticated() && (
        esAdminTotal() ||
        (
          getRol() in ['profesor', 'instructor'] &&
          request.resource.data.get('teamId', '') == resource.data.get('teamId', '') &&
          request.resource.data.get('codigoAcceso', '') == resource.data.get('codigoAcceso', '') &&
          (
            resource.data.get('teamId', '') == getMiTeam() ||
            resource.data.get('academiaId', '') == getMiAcademia() ||
            resource.data.get('teamId', '') == request.auth.uid ||
            resource.data.get('profesorUid', '') == request.auth.uid ||
            resource.data.get('teamIdProfesor', '') == request.auth.uid ||
            getMiSede() == sedeId
          )
        )
      );

      allow delete: if esAdminTotal();
    }

    // 3.b CÓDIGOS DE ACCESO
    // El documento se identifica por el código. Se puede leer por ID exacto
    // (para vincularse) pero NO listar: así no se pueden enumerar.
    match /codigosAcceso/{codigo} {
      allow get: if isAuthenticated();

      allow list: if esAdminTotal();

      allow create, update: if esValidado() && (
        esAdminTotal() ||
        request.auth.uid == request.resource.data.get('teamId', '') ||
        (getRol() in ['profesor', 'instructor'] &&
          request.resource.data.get('teamId', '') == getMiTeam())
      );

      allow delete: if esAdminTotal();
    }

    // 4. ACADEMIAS
    match /academias/{academiaId} {
      // Nombre y logo no son secretos; el listado se usa para el Hub.
      allow read: if isAuthenticated();

      allow write: if esAdminTotal() || (esValidado() && getRol() in ['profesor', 'instructor'] && request.auth.uid == academiaId);
    }

    // 5. ALUMNOS
    // Aislamiento estricto por SEDE:
    // - Admin: todo.
    // - Profesor e instructor: SOLO los alumnos de su propia sede.
    //   El profesor de la sede madre NO ve los alumnos de sus sedes afiliadas.
    match /alumnos/{alumnoId} {

      allow read: if esValidado() && (
        esAdminTotal() ||
        (getRol() in ['profesor', 'instructor'] &&
          resource.data.get('teamId', '') == getMiTeam() &&
          resource.data.get('sedeId', '') == getMiSede())
      );

      allow create: if esValidado() && (
        esAdminTotal() ||
        (getRol() in ['profesor', 'instructor'] &&
          request.resource.data.get('teamId', '') == getMiTeam() &&
          request.resource.data.get('sedeId', '') == getMiSede())
      );

      allow update: if esValidado() && (
        esAdminTotal() ||
        (getRol() in ['profesor', 'instructor'] &&
          resource.data.get('teamId', '') == getMiTeam() &&
          resource.data.get('sedeId', '') == getMiSede() &&
          request.resource.data.get('teamId', '') == getMiTeam() &&
          request.resource.data.get('sedeId', '') == getMiSede())
      );

      allow delete: if esValidado() && (
        esAdminTotal() ||
        (getRol() in ['profesor', 'instructor'] &&
          resource.data.get('teamId', '') == getMiTeam() &&
          resource.data.get('sedeId', '') == getMiSede())
      );
    }

    // 6. CLASES / CONTENIDO
    // Las clases son operativas y locales a la SEDE. Incluyen asistencia
    // (nombres y notas de alumnos), por eso NO se comparten entre sedes.
    // El contenido compartido se publica con rutas/instruccionales.
    match /clases/{claseId} {
      allow read: if isAuthenticated() && (
        esAdminTotal() ||
        (esValidado() &&
          getRol() in ['profesor', 'instructor'] &&
          resource.data.get('teamId', '') == getMiTeam() &&
          resource.data.get('sedeId', '') == getMiSede())
      );

      allow create: if esValidado() && (
        esAdminTotal() ||
        (getRol() in ['profesor', 'instructor'] &&
          request.resource.data.get('teamId', '') == getMiTeam() &&
          request.resource.data.get('sedeId', '') == getMiSede())
      );

      allow update: if esValidado() && (
        esAdminTotal() ||
        (getRol() in ['profesor', 'instructor'] &&
          resource.data.get('teamId', '') == getMiTeam() &&
          resource.data.get('sedeId', '') == getMiSede() &&
          request.resource.data.get('teamId', '') == getMiTeam() &&
          request.resource.data.get('sedeId', '') == getMiSede())
      );

      allow delete: if esValidado() && (
        esAdminTotal() ||
        (getRol() in ['profesor', 'instructor'] &&
          resource.data.get('teamId', '') == getMiTeam() &&
          resource.data.get('sedeId', '') == getMiSede())
      );
    }

    // 7. NOTAS Y SOPORTE
    match /notas/{notaId} {
      allow read, update, delete: if esValidado() && (request.auth.uid == resource.data.get('usuarioId', '') || esAdminTotal());
      allow create: if esValidado() && (request.auth.uid == request.resource.data.get('usuarioId', '') || esAdminTotal());
    }

    // 8. ANUNCIOS Y ACTUALIZACIONES
    match /anuncios/{anuncioId} {
      allow read: if isAuthenticated();
      allow write: if esAdminTotal();
    }

    match /soporte/{ticketId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAuthenticated() && esAdminTotal();
    }

    // 9. TIMER
    match /timer/{timerId} {
      allow read: if esValidado();
      allow create: if esValidado() && (request.auth.uid == request.resource.data.get('usuarioId', '') || getRol() in ['admin', 'profesor', 'instructor']);
      allow update, delete: if esValidado() && (request.auth.uid == resource.data.get('usuarioId', '') || getRol() in ['admin', 'profesor', 'instructor']);
    }

    // 10. VIDEOS INDEXADOS Y RUTAS DE APRENDIZAJE
    // Metadatos legibles solo por usuarios validados. El acceso de reproducción
    // real se sigue validando en la app con asignaciones publicadas.
    match /videos/{videoId} {
      allow read: if esValidado();
      allow write: if esAdminTotal();
    }

    // Cursos importados desde Drive: se suman al índice del Vault.
    match /cursosVault/{cursoId} {
      allow read: if esValidado();
      allow write: if esAdminTotal();
    }

    match /rutas/{rutaId} {
      allow read: if esValidado();
      allow write: if esAdminTotal();
    }

    match /asignacionesRuta/{asignacionId} {
      allow read: if esValidado();
      allow write: if esAdminTotal();
    }

    // Marcas de tiempo globales de instruccionales: las crea el admin y las
    // ven todos los usuarios validados. Son independientes de las notas privadas.
    match /marcasVideo/{marcaId} {
      allow read: if esValidado();
      allow write: if esAdminTotal();
    }
  }
}
