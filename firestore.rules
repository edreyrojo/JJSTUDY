rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- FUNCIONES MEJORADAS Y BLINDADAS ---

    function isAuthenticated() {
      return request.auth != null;
    }

    // Devuelve null si el documento todavía no existe (usuario nuevo).
    // ANTES: get(...).data directo -> error para usuarios sin documento ->
    // Firestore negaba con "Missing or insufficient permissions" cualquier
    // operación que usara getRol()/esValidado()/getMiTeam().
    function getUserData() {
      let userDoc = get(/databases/$(database)/documents/usuarios/$(request.auth.uid));
      return userDoc != null ? userDoc.data : null;
    }

    function getRol() {
      let userData = getUserData();
      return userData != null ? userData.get('rol', 'sin_rol') : 'sin_rol';
    }

    // Admin por UID histórico O por correo. Así el maestro conserva sus
    // permisos sin importar si entra con contraseña o con Google.
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.uid == "V3vfEnmtSzRNljxJVG8Za4gOb9W2" ||
        request.auth.token.email == "zamna.ed@gmail.com"
      );
    }

    // Admin total = el maestro (UID/correo) o cualquier usuario que el maestro
    // haya marcado con rol "admin" desde el panel.
    function esAdminTotal() {
      return isAdmin() || (isAuthenticated() && getRol() == 'admin');
    }

    function esValidado() {
      return isAuthenticated() && (
        esAdminTotal() ||
        (getUserData() != null && getUserData().get('validado', false) == true)
      );
    }

    // Función segura para obtener el academiaId o fallback usando .get()
    function getMiAcademia() {
      let data = getUserData();
      return data != null ? data.get('academiaId', data.get('teamId', request.auth.uid)) : request.auth.uid;
    }

    // Función segura para obtener el teamId o fallback usando .get()
    function getMiTeam() {
      let data = getUserData();
      return data != null ? data.get('teamId', data.get('academiaId', request.auth.uid)) : request.auth.uid;
    }

    function getMiSede() {
      let data = getUserData();
      return data != null ? data.get('sedeId', '') : '';
    }

    function esDeMiEquipo() {
      return resource.data.get('teamId', '') == getMiTeam() ||
             resource.data.get('academiaId', '') == getMiAcademia();
    }

    // --- REGLAS DE COLECCIONES ---

    // 1. USUARIOS
    match /usuarios/{userId} {

      // Leer UN documento: siempre el propio (aunque no esté validado),
      // el admin, o un profesor/instructor sobre su equipo.
      allow get: if isAuthenticated() && (
        request.auth.uid == userId ||
        esAdminTotal() ||
        (getRol() in ['profesor', 'instructor'] && esDeMiEquipo())
      );

      // Consultar/listar:
      // - Admin: todos los usuarios.
      // - Profesor/instructor: los de su equipo.
      // - Cualquier usuario: solo documentos con SU correo. Esto habilita la
      //   búsqueda where("email", "==", miCorreo) del login con Google y evita
      //   el "Missing or insufficient permissions" de los usuarios nuevos.
      allow list: if isAuthenticated() && (
        esAdminTotal() ||
        (getRol() in ['profesor', 'instructor'] && esDeMiEquipo()) ||
        resource.data.get('email', '') == request.auth.token.email
      );

      // Crear el propio perfil: SIEMPRE nace pendiente de validación.
      // Un usuario no puede auto-asignarse el rol admin ni validarse.
      allow create: if isAuthenticated() && request.auth.uid == userId && (
        (
          request.resource.data.get('email', '') == request.auth.token.email &&
          request.resource.data.get('validado', false) == false &&
          request.resource.data.get('rol', 'alumno') != 'admin'
        ) ||
        (
          // Excepción: el maestro creando su propio perfil de admin.
          isAdmin() &&
          request.resource.data.get('rol', '') == 'admin' &&
          request.resource.data.get('validado', false) == true
        )
      );

      // Actualizar: el admin valida y cambia roles. El usuario puede editar su
      // perfil/onboarding, pero NO puede marcarse validado ni hacerse admin.
      allow update: if isAuthenticated() && (
        esAdminTotal() ||
        (
          request.auth.uid == userId &&
          request.resource.data.get('rol', 'alumno') != 'admin' &&
          request.resource.data.get('validado', false) == resource.data.get('validado', false)
        )
      );

      allow delete: if esAdminTotal();
    }

    // 2. TEAMS
    match /teams/{teamId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == teamId || esAdminTotal());
    }

    // 3. SEDES (Blindaje total y flexible para Onboarding y Gestión)
    match /sedes/{sedeId} {
      allow read: if isAuthenticated();

      // Permite creación a profesores/instructores asignando su teamId o por UID directo
      allow create: if isAuthenticated() && (
        esAdminTotal() ||
        (getRol() in ['profesor', 'instructor'] && (
          request.resource.data.get('teamId', '') == getMiTeam() ||
          request.resource.data.get('teamId', '') == request.auth.uid
        ))
      );

      // PERMITE EDICIÓN SI: Es admin, coincide el teamId/academiaId, o si el documento de la sede
      // guarda explícitamente su UID en campos de enlace (teamId o profesorUid), o si su perfil tiene el sedeId.
      allow update, delete: if isAuthenticated() && (
        esAdminTotal() ||
        (getRol() in ['profesor', 'instructor'] && (
          resource.data.get('teamId', '') == getMiTeam() ||
          resource.data.get('academiaId', '') == getMiAcademia() ||
          resource.data.get('teamId', '') == request.auth.uid ||
          resource.data.get('profesorUid', '') == request.auth.uid ||
          resource.data.get('teamIdProfesor', '') == request.auth.uid ||
          getMiSede() == sedeId
        ))
      );
    }

    // 4. ACADEMIAS
    match /academias/{academiaId} {
      allow read: if isAuthenticated();

      // El Admin entra directo. El profesor/instructor solo si está validado y es el dueño.
      allow write: if esAdminTotal() || (esValidado() && getRol() in ['profesor', 'instructor'] && request.auth.uid == academiaId);
    }

    // 5. ALUMNOS (El Admin tiene superpoderes de edición y lectura global)
    match /alumnos/{alumnoId} {

      allow read: if esValidado() && (
        esAdminTotal() ||
        esDeMiEquipo()
      );

      allow create: if esValidado() && (
        esAdminTotal() ||
        (getRol() in ['profesor', 'instructor'] && (
          request.resource.data.get('teamId', '') == getMiTeam() ||
          request.resource.data.get('academiaId', '') == getMiAcademia()
        ))
      );

      allow update: if esValidado() && (
        esAdminTotal() ||
        (getRol() in ['profesor', 'instructor'] &&
          esDeMiEquipo() &&
          (request.resource.data.get('teamId', '') == getMiTeam() || request.resource.data.get('academiaId', '') == getMiAcademia()))
      );

      allow delete: if esValidado() && (
        esAdminTotal() ||
        (getRol() in ['profesor', 'instructor'] && esDeMiEquipo())
      );
    }

    // 6. CLASES / CONTENIDO
    match /clases/{claseId} {
      allow read: if isAuthenticated() && (
        esAdminTotal() ||
        resource.data.get('teamId', '') == getMiTeam()
      );

      allow create: if esValidado() && (
        esAdminTotal() ||
        (getRol() in ['profesor', 'instructor'] && request.resource.data.get('teamId', '') == getMiTeam())
      );

      allow update: if esValidado() && (
        esAdminTotal() ||
        (getRol() in ['profesor', 'instructor'] && resource.data.get('teamId', '') == getMiTeam() && request.resource.data.get('teamId', '') == getMiTeam())
      );

      allow delete: if esValidado() && (
        esAdminTotal() ||
        (getRol() in ['profesor', 'instructor'] && resource.data.get('teamId', '') == getMiTeam())
      );
    }

    // 7. NOTAS Y SOPORTE
    match /notas/{notaId} {
      allow read, update, delete: if esValidado() && (request.auth.uid == resource.data.get('usuarioId', '') || esAdminTotal());
      allow create: if esValidado() && (request.auth.uid == request.resource.data.get('usuarioId', '') || esAdminTotal());
    }

    // 8. ANUNCIOS Y ACTUALIZACIONES
    match /anuncios/{anuncioId} {
      allow read: if isAuthenticated();
      allow write: if esAdminTotal();
    }

    match /soporte/{ticketId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAuthenticated() && esAdminTotal();
    }

    // 9. TIMER
    match /timer/{timerId} {
      allow read: if esValidado();
      allow create: if esValidado() && (request.auth.uid == request.resource.data.get('usuarioId', '') || getRol() in ['admin', 'profesor', 'instructor']);
      allow update, delete: if esValidado() && (request.auth.uid == resource.data.get('usuarioId', '') || getRol() in ['admin', 'profesor', 'instructor']);
    }
  }
}
